{
  "mcpServers": {
    "napcat": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "timeoutMs": 120000,
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "NAPCAT_EXPORT_DIR": "${user_config.exportDir}",
        "NAPCAT_INCLUDE_IMAGES": "${user_config.includeImages}",
        "NAPCAT_DOWNLOAD_PROXY": "${user_config.downloadProxy}",
        "NAPCAT_DESKTOP_QQ_PATH": "${user_config.desktopQqPath}",
        "ZCODE_PROJECT_DIR": "${ZCODE_PROJECT_DIR}",
        "ZCODE_PLUGIN_DATA": "${ZCODE_PLUGIN_DATA}"
      }
    }
  }
}
